rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // Assumed Data Model
    // =============================================================
    // Collection path: users/{authUid}/planner/{documentId}
    // Ownership: the Firebase Authentication UID in the path.
    // Planner document (documentId is the plan id):
    //   id: string (required, <= 100 chars, immutable by matching documentId)
    //   type: string (required: daily, monthly, or yearly)
    //   title: string (required, 1-120 chars)
    //   priority: string (required: normal, medium, or high)
    //   notes: string (required, <= 4000 chars)
    //   createdAt: integer milliseconds (required, > 0, immutable)
    //   completed: boolean (required)
    //   date: YYYY-MM-DD string (daily only)
    //   month: YYYY-MM string (monthly only)
    //   year: YYYY string (yearly only, 1900-2100)
    //   start/end: optional HH:mm strings (daily only; empty is allowed)
    //   location: optional string (daily only, <= 160 chars)
    // Metadata document (documentId is "meta"):
    //   workspaceTitle: string (required, <= 80 chars)
    //   workspaceTitleConfigured: boolean (required)
    // Legacy collection: todos/{todoId} retains owner-only access for the
    // existing schema (id, owner, parentId, title, completed, order,
    // createdTime). Documents are never shared across users.
    // No profile PII or client-assigned permissions are stored in these docs.
    // =============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function optionalString(field, maxLength) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= maxLength);
    }

    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function validTime(value) {
      return value is string && (value == '' || value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    function isValidMetadata(data) {
      return data.keys().hasAll(['workspaceTitle', 'workspaceTitleConfigured']) &&
        data.keys().hasOnly(['workspaceTitle', 'workspaceTitleConfigured']) &&
        data.workspaceTitle is string && data.workspaceTitle.size() <= 80 &&
        data.workspaceTitleConfigured is bool;
    }

    function isValidPlan(planId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'type', 'title', 'priority', 'notes', 'createdAt', 'completed']) &&
        data.keys().hasOnly(['id', 'type', 'title', 'priority', 'notes', 'createdAt', 'completed', 'date', 'month', 'year', 'start', 'end', 'location']) &&
        data.id is string && data.id == planId && data.id.size() <= 100 &&
        data.type in ['daily', 'monthly', 'yearly'] &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.priority in ['normal', 'medium', 'high'] &&
        data.notes is string && data.notes.size() <= 4000 &&
        data.createdAt is int && data.createdAt > 0 &&
        data.completed is bool &&
        optionalString('location', 160) && optionalString('date', 10) &&
        optionalString('month', 7) && optionalString('year', 4) &&
        optionalString('start', 5) && optionalString('end', 5) &&
        ((data.type == 'daily' && 'date' in data && validDate(data.date) &&
          !('month' in data) && !('year' in data) &&
          (!('start' in data) || validTime(data.start)) &&
          (!('end' in data) || validTime(data.end)) &&
          (('start' in data) == ('end' in data)) &&
          (!('location' in data) || data.location is string)) ||
         (data.type == 'monthly' && 'month' in data &&
          data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') &&
          !('date' in data) && !('year' in data) &&
          !('start' in data) && !('end' in data) && !('location' in data)) ||
         (data.type == 'yearly' && 'year' in data &&
          data.year.matches('^(19[0-9]{2}|20[0-9]{2}|2100)$') &&
          !('date' in data) && !('month' in data) &&
          !('start' in data) && !('end' in data) && !('location' in data)));
    }

    function isValidTodo(todoId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'owner', 'parentId', 'title', 'completed', 'order', 'createdTime']) &&
        data.keys().hasOnly(['id', 'owner', 'parentId', 'title', 'completed', 'order', 'createdTime']) &&
        data.id is string && data.id == todoId && data.id.size() <= 128 &&
        data.owner is string && data.owner == request.auth.uid &&
        data.parentId is string && data.parentId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.completed is bool &&
        data.order is int && data.order >= 0 && data.order <= 100000 &&
        data.createdTime is timestamp;
    }

    match /users/{userId}/planner/{documentId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() &&
        ((documentId == 'meta' && isValidMetadata(request.resource.data)) ||
         (documentId != 'meta' && isValidPlan(documentId)));
      allow update: if isOwner(userId) && uidNotModified() &&
        ((documentId == 'meta' && isValidMetadata(request.resource.data)) ||
         (documentId != 'meta' && isValidPlan(documentId) &&
          request.resource.data.createdAt == resource.data.createdAt));
      allow delete: if isOwner(userId);
    }

    match /todos/{todoId} {
      allow get, list: if isAuthenticated() && resource.data.owner == request.auth.uid;
      allow create: if isAuthenticated() && isValidTodo(todoId) && uidUnchanged();
      allow update: if isAuthenticated() && resource.data.owner == request.auth.uid &&
        isValidTodo(todoId) && uidNotModified() &&
        request.resource.data.owner == resource.data.owner &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdTime == resource.data.createdTime;
      allow delete: if isAuthenticated() && resource.data.owner == request.auth.uid;
    }
  }
}
